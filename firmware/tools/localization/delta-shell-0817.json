    "deltaIndex": 63,
    "source": "sh file.sh [arguments...]\nsource file.sh [arguments...]\nBoth execute in this terminal; $0..$9, $? and $PWD are available.\nCreate shell files in the text editor. Maximum script: 32 KiB.\n",
    "english": "sh file.sh [arguments...]\nsource file.sh [arguments...]\nBoth execute in this terminal; $0..$9, $? and $PWD are available.\nCreate shell files in the text editor. Maximum script: 32 KiB.\n",
