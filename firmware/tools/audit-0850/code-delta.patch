+ lv_draw_buf_t buffer{};
+ if(lv_draw_buf_init(&buffer,r.sourceW,r.sourceH,LV_COLOR_FORMAT_A8,r.stride,r.pixels,bytes)!=LV_RESULT_OK){lv_obj_delete(canvas);release(r,doc);return false;}
